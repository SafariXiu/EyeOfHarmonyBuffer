.gradle
.settings
/.idea/
/.vscode/
/run/
# ============ build/：整体忽略；但 eoh_probe/refs 的【证据链】要入库 ============
# 为什么：refs 是降水标定（ALPHA_COND / EP_COND / ALPHA_SH / ENTRAIN_A）的全部证据链，
#   过去被整体忽略 —— 外部审计点名「清一次 build 就销毁」。
# 用户裁决 D-7 = 方案 B：入库 T1 生成器 + T1b 读数/摘录 + T1c 读图存档 + T2a 生产输入，
#   实测 367 个文件 / 49.61 MB（其中 etopo1_025.npz 是 ZonalTables 生产表的地形输入）。
# 不入库（公开源可重下、或可由脚本重建）：
#   .npy 下载缓存 156.1 MB / .pdf 文献 65.4 MB / .nc 再分析 27.6 MB /
#   ls_chunk_* 中间产物 35.8 MB / .bin 5.0 MB / .gz 3.2 MB   —— 合计 293.1 MB
# ★ 为什么不能只写一条 refs 的否定规则：原来的 /build/ 是【目录级】忽略，
#   git 根本不会进入该目录，任何子目录内的否定规则都不生效；必须先改成 /build/*
#   再逐级用 ! 放行。改这条时务必用 git check-ignore -v 实测（只读命令）。
/build/*
!/build/eoh_probe/
/build/eoh_probe/*
!/build/eoh_probe/refs/
!/build/eoh_probe/refs/**
/build/eoh_probe/refs/**/*.npy
/build/eoh_probe/refs/**/*.pdf
/build/eoh_probe/refs/**/*.nc
/build/eoh_probe/refs/**/*.bin
/build/eoh_probe/refs/**/*.gz
/build/eoh_probe/refs/**/ls_chunk_*.npz
/eclipse/
.classpath
.project
/bin/
/config/
/crash-reports/
/logs/
options.txt
/saves/
usernamecache.json
banned-ips.json
banned-players.json
eula.txt
ops.json
server.properties
servers.dat
usercache.json
whitelist.json
/out/
*.iml
*.ipr
*.iws
*.bat
*.DS_Store
!gradlew.bat
# probe harness is version-controlled on purpose: build\ and run\ are gitignored, so
# keeping it under build\ meant clearing build\ destroyed the whole evidence suite.
!tools/talos-probe/*.bat
.factorypath
addon.local.gradle
addon.local.gradle.kts
addon.late.local.gradle
addon.late.local.gradle.kts
layout.json

# ============ research/：只入库【交付物】，不入库草稿纸 ============
# 本仓库的既有约定见上：build\ 被忽略，取数/参考脚本就留在那里（build\eoh_probe\refs\*.py
# 因此不受版本控制）。research\ 沿用同一条约定。实测体量：
#   全部 455 个文件 / 328.4 MB —— 其中 pdfs\ 是 348 个已下载 PDF = 328.1 MB，
#   另有 89 个一次性抓取脚本（oa2/citecheck1-6/meta1-4/probe1-4/_bulk1-4 ...）与 12 个 spec dump。
# 入库的【交付物】：STEADY_STATE_MODEL_EQUATIONS.md、sections\*.md、pdfs\_report_*.md、
#   B-climate-engineering-survey.md，以及三个被点名的可复用取数工具。
# 若还要留下别的脚本，加一行 `!research/<名字>.py` 即可。
/research/pdfs/*
!/research/pdfs/*.md
/research/__pycache__/
/research/we/
/research/*.py
/research/*.json
!research/oa2.py
!research/wb.py
!research/fetch_pdf.py

# ============ 探针/命令行的临时日志：不入库 ============
# 为什么需要：交付物是 build/ 下的 *_report.txt 与 tools/talos-probe/CALIBERS.md；
# 而 runp.bat 的【命令行重定向】（例如 > p701.txt）过去写在源码目录，
# 导致 79 个调试日志变成未跟踪文件、会被手工提交带进仓库。这里一次性忽略。
# 若确有需要入库的 .txt，用 !tools/talos-probe/<名字>.txt 显式放行。
/*.txt
/tools/talos-probe/*.txt
